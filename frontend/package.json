{
  "name": "loupe-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('build/.gitkeep','')\"",
