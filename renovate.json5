{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Sensible Renovate defaults (dependency dashboard, grouping, etc.), plus:
  //  - pin GitHub Actions to commit SHAs and keep the pins current,
  //  - conventional commit messages (chore(deps): ...), which cliff.toml skips,
  //  - bump the `# renovate:` annotated *_VERSION pins in the Makefile, the
  //    Dockerfile (gallery-dl) and the workflows (release tooling).
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
    'customManagers:makefileVersions',
    'customManagers:dockerfileVersions',
    'customManagers:githubActionsVersions',
  ],

  // Wait a few days after a release before proposing it: lets yanked versions
  // and day-one regressions (or compromised packages) get caught upstream first.
  minimumReleaseAge: '3 days',

  // Keep go.sum tidy after Go updates; bump pre-commit hook revisions too.
  postUpdateOptions: ['gomodTidy'],
  'pre-commit': { enabled: true },

  // Automerge every update type — patch / minor / major / digest / pin ...
  automerge: true,
  // ... but always through a PR, so the CI workflows run first.
  automergeType: 'pr',
  // Renovate performs the merge itself once it sees the branch status is green.
  // `ignoreTests` stays at its default (false), so a pending or failing check
  // blocks the merge — i.e. "automerge only what passes CI" — and this holds
  // without requiring branch protection to be configured.
  platformAutomerge: false,

  packageRules: [
    {
      // The SvelteKit toolchain is version-locked as a unit: @sveltejs/kit
      // controls which @sveltejs/vite-plugin-svelte major it accepts and which
      // Vite range is supported. Bumping any one in isolation (e.g. the plugin
      // to v7, which peer-requires Vite 8 while kit still wants the v4 plugin)
      // produces an unresolvable peer tree and a red, unmergeable PR. Group
      // them so they only ever move together, once kit supports the new set.
      matchPackageNames: ['svelte', 'vite', '@sveltejs/**'],
      groupName: 'SvelteKit toolchain',
    },
    {
      // The runtime image's Alpine packages (ffmpeg, ca-certificates). The
      // dockerfile manager extracts the `apk add pkg=ver` pins but skips them
      // until it is told which repository to read; it does not derive that
      // from the base image. Keep `branch` in step with the python image's
      // alpineX.Y suffix, and `arch` with the platform docker.yaml builds.
      matchFileNames: ['Dockerfile'],
      matchDatasources: ['apk'],
      registryUrls: [
        'https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64',
      ],
      // Alpine's index only carries the newest build of a package: the moment
      // a new one is published, the old pin no longer installs and the image
      // build fails. Waiting out minimumReleaseAge would keep it broken.
      minimumReleaseAge: '0 days',
    },
    {
      // gallery-dl and ffmpeg ship inside the image, so a bump is a
      // user-facing change: commit it as fix(deps) so git-cliff lists it in
      // the changelog (cliff.toml skips chore(deps)). Once it lands on main,
      // .github/workflows/release.yml cuts a patch release.
      matchPackageNames: ['gallery-dl', 'ffmpeg'],
      semanticCommitType: 'fix',
    },
  ],
}
